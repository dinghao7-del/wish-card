# Supabase 配置
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 可选：PostHog 行为分析（免费版）
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# 可选：Cloudflare R2 存储（用于图片上传）
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=

# 可选：邮件服务（Resend）
RESEND_API_KEY=

# 可选：短信服务（Twilio）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 微信小程序自动发布
# WX_APPID 可省略，脚本会优先读取 miniprogram/dist/project.config.json
WX_APPID=
WX_APP_SECRET=
WX_RELEASE_VERSION=
WX_AUDIT_ADDRESS=pages/login/index
WX_AUDIT_TITLE=WishCard 家庭管家
WX_AUDIT_TAG=家庭,日程,习惯,教育
WX_AUDIT_FIRST_CLASS=
WX_AUDIT_SECOND_CLASS=
WX_AUDIT_THIRD_CLASS=
WX_AUDIT_FIRST_ID=
WX_AUDIT_SECOND_ID=
WX_AUDIT_THIRD_ID=
# 高级用法：直接填微信 submit_audit 的 item_list JSON，可覆盖上面的类目字段
WX_AUDIT_ITEM_LIST=
