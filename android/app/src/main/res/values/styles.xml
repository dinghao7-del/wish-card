<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础应用主题 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary</item>
        <item name="colorAccent">@color/primary_container</item>
    </style>

    <!-- WebView 全屏主题（无 ActionBar，保持背景色一致避免闪白屏） -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 全面屏内容延伸到系统栏区域 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- 让内容延伸到导航栏和状态栏下面 -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <!-- 启动屏主题：继承 SplashScreen，启动后切换到 NoActionBar 主题 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash</item>
        <!-- 关键：指定 Splash 消失后切换的主题，防止闪白屏 -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowSplashScreenBackground">@color/primary</item>
    </style>

</resources>
