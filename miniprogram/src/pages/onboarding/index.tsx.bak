/**
 * OnboardingGuide 新手引导 — 100% 严格对齐 Web 端 src/pages/OnboardingGuide.tsx (2317行)
 *
 * 完整步骤(11步):
 * Step 'welcome'      - 欢迎页 + 上次保存记录恢复
 * Step 'family-type'  - 您的家庭类型是？(核心/大家庭/单亲) + 家中有孩子checkbox
 * Step 'children-count'- 您有几个孩子？ (±按钮 1-4)
 * Step 'child-details' - {孩子名}的信息: 头像选择器+名字+年龄滑块(3-18)+性别+年级下拉
 * Step 'daily-schedule'- {孩子名}的作息时间: 到校/放学time input + 课外班checkbox
 * Step 'activities'   - {孩子名}的课外活动: 分类网格(体育/艺术/STEM/语言)+自定义输入
 * Step 'holiday-schedule' - 假期作息变化? 时间+特别活动标签
 * Step 'priorities'   - 最看重哪些方面？emoji 2x3卡片(📚学习/💪健康/🧹家务/🤝社交/🎨兴趣/⭐责任)
 * Step 'analyzing'    - AI分析动画 + 进度条 + 分析维度列表
 * Step 'recommendations'- 选择项目: 任务卡片(图标+描述+⭐) + 习惯卡片(紫色)
 * Step 'preview'      - 预览画卷: 家庭渐变卡+作息概览+任务列表+习惯列表+心愿推荐+特殊需求
 * Step 'success'      - 完成! 绿勾 + 统计 + 前往首页
 */
import { View, Text, ScrollView, Input, Slider, Picker, Textarea } from '@tarojs/components';
import { useState, useEffect } from 'react';
import Taro from '@tarojs/taro';
import Icon from '@/components/Icon';
import './index.scss';

// ===== 对齐Web第16-37行 =====
interface ChildInfo {
  name: string;
  age: number;
  gender: 'boy' | 'girl';
  grade: string;
  avatar: string;
  schoolTime: { start: string; end: string };
  hasAfterSchool: boolean;
  afterSchoolActivities: string[];
  customActivities: string[];
}

interface FamilyProfile {
  hasChildren: boolean;
  childrenCount: number;
  children: ChildInfo[];
  familyType: 'nuclear' | 'extended' | 'single';
  priorities: string[];
  specialRequests: string;
  hasHolidaySchedule: boolean;
  holidayDaySchedule: { start: string; end: string };
  holidayCustomActivities: string[];
}

interface RecommendedTask {
  id: string; title: string; description: string;
  type: 'daily' | 'weekly' | 'habit'; rewardStars: number;
  icon: string; category: string; assigneeChildNames?: string[];
  suggestedTime?: string;
}

type OnboardStep = 'welcome' | 'family-type' | 'children-count' | 'child-details'
  | 'daily-schedule' | 'activities' | 'holiday-schedule' | 'priorities' | 'analyzing'
  | 'recommendations' | 'preview' | 'success';

function getGradeFromAge(age: number): string {
  if (age <= 3) return '幼儿园小班';
  if (age === 4) return '幼儿园中班';
  if (age === 5) return '幼儿园大班';
  const map: Record<number, string> = {6:'小学一年级',7:'小学二年级',8:'小学三年级',9:'小学四年级',10:'小学五年级',11:'小学六年级',12:'初中一年级',13:'初中二年级',14:'初中三年级',15:'高中一年级',16:'高中二年级'};
  return map[age] || '高中三年级';
}

const BOY_AVATARS = ['👦','🧑','👲','👱','👳','🧔','👴','🧒','👶','🕴️'];
const GIRL_AVATARS = ['👧','👩','👵','🧕','🙍','🙎','💁','🙋','🤦','🧏'];

function getDefaultAvatar(gender: 'boy'|'girl', id: number): string {
  const list = gender === 'boy' ? BOY_AVATARS : GIRL_AVATARS;
  return list[id % list.length];
}

const GRADE_OPTIONS = ['幼儿园小班','幼儿园中班','幼儿园大班','小学一年级','小学二年级','小学三年级','小学四年级','小学五年级','小学六年级','初中一年级','初中二年级','初中三年级','高中一年级','高中二年级','高中三年级'];

const ACTIVITY_COMMON = [
  {id:'游泳',label:'游泳',category:'sports'},{id:'足球',label:'足球',category:'sports'},
  {id:'篮球',label:'篮球',category:'sports'},{id:'跑步',label:'跑步',category:'sports'},
  {id:'跳绳',label:'跳绳',category:'sports'},{id:'羽毛球',label:'羽毛球',category:'sports'},
  {id:'钢琴',label:'钢琴',category:'arts'},{id:'绘画',label:'绘画',category:'arts'},
  {id:'舞蹈',label:'舞蹈',category:'arts'},{id:'书法',label:'书法',category:'arts'},
  {id:'围棋',label:'围棋',category:'stem'},{id:'编程',label:'编程',category:'stem'},
  {id:'科学实验',label:'科学实验',category:'stem'},{id:'英语',label:'英语',category:'language'},
  {id:'阅读',label:'阅读',category:'language'},
];
const ACT_BOY_EXTRA = [{id:'武术',label:'武术',category:'sports'},{id:'乐高',label:'乐高',category:'stem'}];
const ACT_GIRL_EXTRA = [{id:'体操',label:'体操',category:'sports'},{id:'主持',label:'主持',category:'arts'}];
function getActivityOptions(gender:'boy'|'girl') {
  return [...ACTIVITY_COMMON,...(gender==='boy'?ACT_BOY_EXTRA:ACT_GIRL_EXTRA)];
}
const CAT_NAMES: Record<string,string> = { sports:'体育类', arts:'艺术类', stem:'STEM类', language:'语言类' };

const PRIORITY_OPTS = [
  {id:'study',label:'学习习惯',emoji:'📚'},{id:'health',label:'健康生活',emoji:'💪'},
  {id:'housework',label:'家务劳动',emoji:'🧹'},{id:'social',label:'社交能力',emoji:'🤝'},
  {id:'hobby',label:'兴趣培养',emoji:'🎨'},{id:'responsibility',label:'责任心',emoji:'⭐'},
];

const HOLIDAY_ACTS = ['夏令营','阅读打卡','家务劳动','创意手工','运动打卡','家庭旅行','兴趣班'];

function makeDefProfile(): FamilyProfile {
  return {
    hasChildren:true, childrenCount:1,
    children:[{name:'大宝', age:8, gender:'boy', grade:'小学三年级',
      avatar:getDefaultAvatar('boy',0), schoolTime:{start:'08:00',end:'16:00'},
      hasAfterSchool:false, afterSchoolActivities:[], customActivities:[]}],
    familyType:'nuclear', priorities:[], specialRequests:'',
    hasHolidaySchedule:false, holidayDaySchedule:{start:'08:00',end:'17:00'}, holidayCustomActivities:[],
  };
}

export default function OnboardingGuide() {
  const [step,setStep] = useState<OnboardStep>('welcome');
  const [ci,setCi] = useState(0);
  const [savedData,setSavedData] = useState<any>(null);
  const [aiStatus,setAiStatus] = useState<'idle'|'waiting'|'done'>('idle');
  const [aiSec,setAiSec] = useState(0);
  const [customInput,setCustomInput] = useState('');
  const [showAvatars,setShowAvatars] = useState(false);

  const [profile,setProfile] = useState<FamilyProfile>(makeDefProfile());
  const [recs,setRecs] = useState<RecommendedTask[]>([]);
  const [selRecs,setSelRecs] = useState<Set<string>>(new Set());

  useEffect(()=>{
    try{ const s=Taro.getStorageSync('wishcard_onboarding_profile'); if(s&&typeof s==='string'){const d=JSON.parse(s);if(d.profile)setSavedData(d);} }catch{}
  },[]);

  const STEPS:OnboardStep[]=['welcome','family-type','children-count','child-details','daily-schedule','activities','holiday-schedule','priorities','analyzing','recommendations','preview','success'];

  const goNext=()=>{
    const i=STEPS.indexOf(step);if(i<0||i>=STEPS.length-1)return;
    if(step==='recommendations'){setStep('preview');return;}
    let ni=i+1;
    if(!profile.hasChildren&&['children-count','child-details','daily-schedule','activities','holiday-schedule'].includes(STEPS[ni])){ni=STEPS.indexOf('priorities');}
    if((step==='child-details'||step==='daily-schedule'||step==='activities')&&ci<profile.childrenCount-1){setCi(c=>c+1);return;}
    setStep(STEPS[ni]);if(STEPS[ni]==='analyzing')doAnalyze();
  };
  const goBack=()=>{
    const i=STEPS.indexOf(step);if(i<=0)return;
    if((step==='child-details'||step==='daily-schedule'||step==='activities')&&ci>0){setCi(c=>c-1);return;}
    setStep(STEPS[i-1]);
  };

  const updChild=(idx:number,u:Partial<ChildInfo>)=>{
    setProfile(p=>({...p,children:p.children.map((c,i)=>i===idx?{...c,...u}:c)}));
  };

  // AI分析 (模拟延迟)
  const doAnalyze=()=>{
    setStep('analyzing');setAiStatus('waiting');setAiSec(0);
    const timer=setInterval(()=>setAiSec(s=>s+1),1000);
    setTimeout(()=>{clearInterval(timer);genLocal();setAiStatus('done');setTimeout(()=>setStep('recommendations'),600);},2800);
  };

  // 本地推荐算法 (对齐Web第363-460行)
  const genLocal=()=>{
    const tasks:RecommendedTask[]=[];
    let idx = 0;
    const mk = (t:string,n:string,d:string,s:number,c:string,tm?:string) => {
      tasks.push({id:'task-'+String(idx++),title:t,description:d,type:('daily' as any),rewardStars:s,icon:iconFor(c),category:c,suggestedTime:tm});
    };
    // 基础任务
    mk('整理书包','每天睡前整理好第二天需要的书本和文具',2,'学习');
    mk('完成作业','按时完成学校布置的作业',3,'学习');
    mk('阅读30分钟','每天坚持阅读课外书籍',2,'阅读');
    mk('锻炼身体','户外运动或体育活动30分钟',2,'运动');
    mk('帮忙做家务','承担一项固定的家务劳动',2,'家务');
    mk('早睡早起','按照约定时间上床睡觉和起床',2,'生活');
    // 按孩子
    profile.children.forEach(ch=>{
      const cn=ch.name||(ch.gender==='boy'?'儿子':'女儿');
      mk(cn+'的专属作业任务','按时完成学校作业是学习习惯培养关键期',4,'学习');
      if(profile.priorities.includes('study')||ch.age>=7&&ch.age<=12){
        mk(cn+'复习本周知识','回顾本周所学内容，查漏补缺',5,'学习');
      }
      if(!profile.children.some(c=>c.afterSchoolActivities.length>0)){
        mk(cn+'户外运动','每天保持适量运动促进身体发育',4,'运动');
      }
    });
    // 习惯
    tasks.push({id:'habit-1',title:'每日阅读',description:'每天坚持阅读15-30分钟，培养终身学习习惯',type:'habit'as any,rewardStars:5,icon:'Sparkles',category:'习惯养成'});
    
    setRecs(tasks.slice(0,15));
    setSelRecs(new Set(tasks.slice(0,Math.ceil(tasks.length/1.5)).map(t=>t.id)));
  };

  const iconFor=(cat:string):string=>({学习习惯:'BookOpen',生活习惯:'Sparkles',自理能力:'Sparkles',健康运动:'Dumbbell',社交礼仪:'Users',自我管理:'Clock',家务劳动:'home',兴趣培养:'Palette'}[cat]||'Sparkles');

  const toggle=(id:string)=>setSelRecs(p=>{const n=new Set(p);n.has(id)?n.delete(id):n.add(id);return n;});

  const confirm=()=>{
    const sel=recs.filter(t=>selRecs.has(t.id));
    Taro.setStorageSync('onboarding_completed',JSON.stringify({profile,recommendedTasks:sel,completedAt:new Date().toISOString()}));
    try{Taro.removeStorageSync('wishcard_onboarding_profile');}catch{}
    Taro.showToast({title:`✅ 成功导入：${profile.childrenCount}个孩子、${sel.filter(t=>t.type!=='habit').length}个任务`,icon:'success'});
    setStep('success');
  };

  const showBtn=!['analyzing','success','preview','welcome'].includes(step);
  const canGo=():boolean=>{
    switch(step){case'priorities':return profile.priorities.length>0;case'recommendations':return selRecs.size>0;default:return true;}
  };

  /* ===================== RENDER ===================== */

  // Welcome
  if(step==='welcome'){
    const hs=!!savedData;
    const sd=savedData?.savedAt?new Date(savedData.savedAt).toLocaleString('zh-CN',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'}):'';
    return (
      <View className="ob-page">
        <View className="ob-card">
          <View className="welcome-icon-wrap"><Icon name="sparkles" size={80} color="#006e1c"/></View>
          <Text className="ob-title">欢迎使用星愿卡</Text>
          <Text className="ob-subtitle">快速建立家庭日程管理</Text>
          {/* 保存记录 — 对齐Web第878-928行 */}
          {hs && (
            <View className="saved-record-card">
              <View className="saved-rec-head">
                <View className="saved-rec-icon"><Icon name="clock" size={28} color="#b45309"/></View>
                <View><Text style={{fontSize:26,fontWeight:800,color:'#92400e'}}>上次的分析记录</Text>
                <Text style={{fontSize:20,color:'#b45309',opacity:0.7}}>保存于 {sd}</Text></View>
              </View>
              <View className="saved-rec-stats">
                {[{v:savedData?.profile?.children?.length||0,l:'孩子'},{v:savedData?.recommendations?.length||0,l:'推荐任务'},
                  {l:'家庭类型', v: savedData?.profile?.familyType==='nuclear'?'👨‍👩‍👧':savedData?.profile?.familyType==='extended'?'👨‍👩‍👧‍👦':'👩‍👧'}].map((it,i)=>
                  <View key={i} className="saved-stat-box"><Text className="saved-stat-num">{typeof it.v==='number'?it.v:it.v}</Text><Text className="saved-stat-lbl">{it.l}</Text></View>)}
              </View>
              <View className="saved-rec-btns">
                <View className="ob-secondary-btn" onClick={()=>{if(savedData){setProfile(savedData.profile);if(savedData.recommendations?.length){setRecs(savedData.recommendations);setSelRecs(new Set(savedData.selectedIds||[]));}setStep('family-type');}}}>
                  <Text style={{fontSize:27,color:'#666'}}>继续编辑</Text></View>
                <View className="ob-primary-btn-small" onClick={()=>{if(savedData){setProfile(savedData.profile);setStep('analyzing');doAnalyze();}}}>
                  <Icon name="sparkles" size={24} color="#fff"/><Text style={{color:'#fff',fontSize:27}}>重新分析</Text></View>
              </View>
              <View className="ob-text-btn" onClick(()=>{try{Taro.removeStorageSync('wishcard_onboarding_profile');setSavedData(null);}catch{}Taro.showToast({title:'已清除'})}}>
                <Text>清除记录，重新开始</Text></View>
            </View>
          )}
          {!hs && <Text className="ob-subtitle" style={{marginTop:32}}>通过几个简单的问题，AI将为您推荐适合的任务和习惯，\n让孩子养成良好的生活规律</Text>}
          <View className="ob-primary-btn" style={{marginTop:'auto',paddingTop:32}} onClick={goNext}><Text>继续</Text><Icon name="chevronRight" size={36} color="#fff"/></View>
        </View>
      </View>
    );
  }

  // Family Type — 对齐Web第953-1001行
  if(step==='family-type'){
    const opts=[{id:'nuclear',l:'核心家庭',d:'父母和孩子'},{id:'extended',l:'大家庭',d:'包含祖父母'},{id:'single',l:'单亲家庭',d:'一位家长带孩子'}];
    return (
      <View className="ob-page">
        <ObHeader onBack={goBack}/>
        <ScrollView scrollY enhanced class="ob-step-body">
          <Text className="ob-step-title">您的家庭类型是？</Text>
          <View className="ft-list">{opts.map(o=>
            <View key={o.id} className={`ft-item ${profile.familyType===o.id?'active':''}`} onClick={()=>setProfile(p=>({...p,familyType:o.id}))}>
              <View className={`ft-icon ${profile.familyType===o.id?'active':''}`}><Icon name="users" size={36} color={profile.familyType===o.id?'#fff':'rgba(0,0,0,0.35)'}/></View>
              <View className="ft-text"><Text className="ft-label">{o.l}</Text><Text className="ft-desc">{o.d}</Text></View>
              {profile.familyType===o.id && <Icon name="checkCircle" size={36} color="#006e1c"/>}
            </View>
          ))}</View>
          {/* "家中有孩子" checkbox — 对齐Web第988-999行 */}
          <View className="chk-row"><View className={`chk-box ${profile.hasChildren?'on':''}`} onClick={()=>setProfile(p=>({...p,hasChildren:!p.hasChildren}))}>{profile.hasChildren && <Icon name="check" size={22} color="#fff"/>}</View>
            <Text className="chk-lbl">家中有孩子</Text></View>
          <View className="sp-h"/>
        </ScrollView>
        <ObFooter onNext={goNext} btnText="下一步"/>
      </View>
    );
  }

  // Children Count — 对齐Web第1003-1054行
  if(step==='children-count'){
    return (<View className="ob-page"><ObHeader onBack={goBack}/>
      <View style={{flex:1,display:'flex',flexDirection:'column',alignItems:'center',justifyContent:'center'}}>
        <Text className="ob-step-title" style={{padding:0}}>您有几个孩子？</Text>
        <View style={{display:'flex',alignItems:'center',gap:40,marginTop:48}}>
          <View className="cc-round-btn" onClick={()=>{if(profile.childrenCount>1)setProfile(p=>({...p,childrenCount:p.childrenCount-1,children:p.children.slice(0,-1)}))}}><Icon name="minus" size={44} color="#333"/></View>
          <Text className="cc-big-num">{profile.childrenCount}</Text>
          <View className="cc-round-btn" onClick={()=>{if(profile.childrenCount<4)setProfile(p=>({...p,childrenCount:p.childrenCount+1,children:[...p.children,{name:'',age:8,gender:p.childrenCount%2===0?'boy':'girl',grade:'小学二年级',avatar:getDefaultAvatar(p.childrenCount%2===0?'boy':'girl',p.childrenCount),schoolTime:{start:'08:00',end:'16:00'},hasAfterSchool:false,afterSchoolActivities:[],customActivities:[]}]}))}}><Icon name="plus" size={44} color="#333"/></View>
        </View>
        <Text className="cc-hint">接下来我们会了解每个孩子的具体情况</Text>
      </View>
      <ObFooter onNext={goNext} btnText="下一步"/>
    </View>);
  }

  // Child Details — 对齐Web第1056-1239行
  if(step==='child-details'){
    const ch=profile.children[ci];
    const dots=profile.children.map((_,i)=><View key={i} className={`dot ${i===ci?'active':''}`}/>);
    return (<View className="ob-page"><ObHeader onBack={ci>0?()=>setCi(c=>c-1):goBack}/>
      <ScrollView scrollY enhanced class="ob-step-body">
        <Text className="ob-step-title">{ch.name?`${ch.name} 的信息`:`孩子${ci+1} 的信息`}</Text>
        <View className="dots-row">{dots}</View>

        {/* 头像选择器 — 对齐Web第1075-1155行 */}
        <View style={{display:'flex',justifyContent:'center',position:'relative',marginBottom:24}}>
          <View className="avatar-circle" onClick={()=>setShowAvatars(!showAvatars)}>
            <Text style={{fontSize:72}}>{ch.avatar||(ch.gender==='boy'?'👦':'👧')}</Text>
          </View>
          {showAvatars && (<>
            <View className="modal-mask" onClick={()=>setShowAvatars(false)}/>
            <View className="avatar-picker">
              <View style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:16}}>
                <Text style={{fontSize:28,fontWeight:900}}>选择头像·{ch.gender==='boy'?'男孩':'女孩'}</Text>
                <View className="tiny-close" onClick={()=>setShowAvatars(false)}><Icon name="x" size={24} color="#333"/></View>
              </View>
              <View style={{display:'flex',flexWrap:'wrap',gap:12}}>
                {(ch.gender==='boy'?BOY_AVATARS:GIRL_AVATARS).map((e,i)=><View key={i}
                  className={`avatar-pick ${ch.avatar===e?'sel':''}`} onClick={()=>{updChild(ci,{avatar:e});setShowAvatars(false);}}><Text style={{fontSize:38}}>{e}</Text></View>)}
              </View>
            </View>
          </>)}
        </View>

        {/* 名字 */}
        <Text className="field-label">名字</Text><Input className="field-input" value={ch.name} placeholder="请输入孩子名字或昵称"
          onInput={(e:any)=>updChild(ci,{name:e.detail.value})}/>
        <Text className="field-hint">创建后将直接建立孩子的账户</Text>

        {/* 年龄滑块 — 对齐Web第1169-1194行 */}
        <Text className="field-label" style={{marginTop:28}}>年龄</Text>
        <View style={{display:'flex',alignItems:'center',gap:16,padding:'6rpx 0'}}>
          <Slider value={ch.age} min={3} max={18} activeColor="#006e1c" backgroundColor="#e5e5e5" blockSize={28} blockColor="#006e1c" flex={1}
            onChange={(e:any)=>{const a=e.detail.value;updChild(ci,{age:a,grade:getGradeFromAge(a),avatar:getDefaultAvatar(ch.gender,a)});}}/>
          <Text className="age-display">{ch.age}<Text style={{fontSize:22}}>岁</Text></Text>
        </View>

        {/* 性别 */}
        <Text className="field-label" style={{marginTop:24}}>性别</Text>
        <View className="gender-row">{[{id:'boy',l:'男孩',e:'👦'},{id:'girl',l:'女孩',e:'👧'}].map(opt=>
          <View key={opt.id} className={`gender-chip ${ch.gender===opt.id?'active':''}`}
            onClick={()=>updChild(ci,{gender:opt.id as 'boy'|'girl',avatar:getDefaultAvatar(opt.id as 'boy'|'girl',ch.age)})}>
            <Text style={{fontSize:34,marginRight:6}}>{opt.e}</Text><Text>{opt.l}</Text></View>)}</View>

        {/* 年级下拉 — 对齐Web第1224-1237行 */}
        <Text className="field-label" style={{marginTop:24}}>年级<Text style={{fontWeight:400,color:'rgba(0,0,0,0.35)'}}>（已根据年龄自动推荐）</Text></Text>
        <Picker mode='selector' range={GRADE_OPTIONS} value={GRADE_OPTIONS.indexOf(ch.grade)>=0?GRADE_OPTIONS.indexOf(ch.grade):2}
          onChange={(e:any)=>updChild(ci,{grade:GRADE_OPTIONS[e.detail.value]})}>
          <View className="field-input pick-box"><Text>{ch.grade}</Text><Icon name="chevronDown" size={26} color="#999"/></View>
        </Picker>
        <View className="sp-h"/>
      </ScrollView>
      <ObFooter onNext={()=>{if(ci<profile.childrenCount-1)setCi(c=>c+1);else goNext();}}
        btnText={ci<profile.childrenCount-1?`下一个：${profile.children[ci+1]?.name||`孩子${ci+2}`}`:'继续'}
        showChevron/>
      </View>
    </View>);
  }

  // Daily Schedule — 对齐Web第1241-1306行
  if(step==='daily-schedule'){
    const sch=profile.children[ci];
    const dots=profile.children.map((_,i)=><View key={i} className={`dot ${i===ci?'active':''}}/>);
    return(<View className="ob-page"><ObHeader onBack={goBack}/>
      <ScrollView scrollY enhanced class="ob-step-body">
        <Text className="ob-step-title">{sch.name?`${sch.name} 的作息时间`:`孩子${ci+1} 的作息时间`}</Text>
        <View className="dots-row">{dots}</View>
        <View className="schedule-card" style={{marginBottom:20}}>
          <View style={{display:'flex',alignItems:'center',gap:10,marginBottom:16}}>
            <Icon name="graduationCap" size={28} color="#666"/><Text style={{fontSize:27,fontWeight:800,color:'#333'}}>上学时间</Text></View>
          <View style={{display:'flex',alignItems:'center',gap:16}}>
            <View style={{flex:1}}><Text className="mini-label">到校</Text>
              <Picker mode='time' value={sch.schoolTime.start} onChange={(e:any)=>updChild(ci,{schoolTime:{...sch.schoolTime,start:e.detail.value}})}>
                <View className="time-pick-box"><Text>{sch.schoolTime.start}</Text></View></Picker></View>
            <Icon name="chevronRight" size={24} color="#ccc"/>
            <View style={{flex:1}}><Text className="mini-label">放学</Text>
              <Picker mode='time' value={sch.schoolTime.end} onChange={(e:any)=>updChild(ci,{schoolTime:{...sch.schoolTime,end:e.detail.value}})}>
                <View className="time-pick-box"><Text>{sch.schoolTime.end}</Text></View></Picker></View>
          </View>
        </View>
        {/* 有课外班checkbox — 对齐Web第1292-1303行 */}
        <View className="chk-row" style={{marginTop:20}}>
          <View className={`chk-box ${sch.hasAfterSchool?'on':''}`} onClick={()=>updChild(ci,{hasAfterSchool:!sch.hasAfterSchool})}>{sch.hasAfterSchool&&<Icon name="check" size={22} color="#fff"/>}</View>
          <Text className="chk-lbl">有课外班 / 托管班</Text></View>
        <View className="sp-h"/>
      </ScrollView>
      <ObFooter onNext={()=>{if(ci<profile.childrenCount-1)setCi(c=>c+1);else goNext();}}
        btnText={ci<profile.childrenCount-1?`下一个：${profile.children[ci+1]?.name||`孩子${ci+2}`}`:'继续'} showChevron/></View>
    </View>);
  }

  // Activities — 对齐Web第1308-1447行
  if(step==='activities'){
    const ac=profile.children[ci];const opts=getActivityOptions(ac.gender);
    const grp:Record<string,typeof opts>={};opts.forEach(o=>{if(!grp[o.category])grp[o.category]=[];grp[o.category].push(o);});
    const allActs=[...ac.afterSchoolActivities,...ac.customActivities];
    return(<View className="ob-page"><ObHeader onBack={goBack}/>
      <ScrollView scrollY enhanced class="ob-step-body">
        <Text className="ob-step-title">{ac.name?`${ac.name} 的课外活动`:`孩子${ci+1} 的课外活动`}</Text>
        <Text className="ob-step-hint">{ac.gender==='boy'?'👦 为男孩推荐':'👧 为女孩推荐'}·选择或输入正在参加的活动</Text>
        <View className="dots-row">{profile.children.map((_,i)=><View key={i} className={`dot ${i===ci?'active':''}}/>)}</View>

        {/* 自定义输入 — 对齐Web第1361-1393行 */}
        <View className="schedule-card" style={{marginBottom:20}}>
          <Text style={{fontSize:24,fontWeight:800,color:'#666',marginBottom:10}}>⊕ 自定义活动（如有未列出的活动可手动添加）</Text>
          <View style={{display:'flex',gap:10}}>
            <Input className="field-input" style={{flex:1,height:76}} value={customInput} placeholder="如：跆拳道、击剑..." onInput={(e:any)=>setCustomInput(e.detail.value)}
              confirmType='done' onConfirm={()=>{if(customInput.trim()&&!ac.customActivities.includes(customInput.trim())){updChild(ci,{customActivities:[...ac.customActivities,customInput.trim()]});setCustomInput('');}}}/>
            <View className={`add-btn ${!customInput.trim()?'dis':''}`} onClick={()=>{if(customInput.trim()&&!ac.customActivities.includes(customInput.trim())){updChild(ci,{customActivities:[...ac.customActivities,customInput.trim()]});setCustomInput('');}}}>
              <Text style={{color:'#fff',fontWeight:800,fontSize:25}}>添加</Text></View>
          </View>
          {ac.customActivities.length>0&&<View style={{display:'flex',flexWrap:'wrap',gap:8,marginTop:12}}>
            {ac.customActivities.map(a=><View key={a} className="cust-tag">
              <Text style={{fontSize:22,fontWeight:800,color:'#006e1c'}}>{a}</Text>
              <View className="rm-x" onClick={()=>updChild(ci,{customActivities:ac.customActivities.filter(x=>x!==a)})}><Icon name="x" size={16} color="#006e1c"/></View></View>)}
          </View>}
        </View>

        {/* 分类网格 — 对齐Web第1396-1430行 */}
        <View style={{maxHeight:480,overflowY:'auto'}}>{Object.entries(grp).map(([cat,acts])=><View key={cat} style={{marginBottom:24}}>
          <Text style={{fontSize:23,fontWeight:900,color:'#666',textTransform:'uppercase',letterSpacing:1,marginBottom:10,display:'block'}}>{CAT_NAMES[cat]}</Text>
          <View style={{display:'grid',gridTemplateColumns:'repeat(3,1fr)',gap:12}}>{acts.slice(0,6).map(act=>{
            const sel=ac.afterSchoolActivities.includes(act.id);return(
              <View key={act.id} className={`act-grid ${sel?'active':''}`}
                onClick(()=>{const nl=sel?ac.afterSchoolActivities.filter(x!==act.id):[...ac.afterSchoolActivities,act.id];updChild(ci,{afterSchoolActivities:nl});})}>
                <Text style={{fontSize:34,marginBottom:4,textAlign:'center',display:'block'}}>{cat==='sports'?'🏀':cat==='arts'?'🎨':cat==='stem'?'🔬':'📖'}</Text>
                <Text style={{fontSize:22,fontWeight:700,textAlign:'center',color:sel?'#006e1c':'#333'}}>{act.label}</Text></View>);
          })}</View></View>)}
        </View>

        {allActs.length>0&&<View className="schedule-card" style={{marginTop:16}}>
          <Text style={{fontSize:23,fontWeight:800,color:'#666',marginBottom:8}}>已选活动（{allActs.length}项）</Text>
          <View style={{display:'flex',flexWrap:'wrap',gap:8}}>{allActs.map((a,i)=><View key={i} className="act-tag"><Text>{a}</Text></View>)}</View>
        </View>}
        <View className="sp-h"/>
      </ScrollView>
      <ObFooter onNext={()=>{if(ci<profile.childrenCount-1)setCi(c=>c+1);else goNext();}}
        btnText={ci<profile.childrenCount-1?`下一个：${profile.children[ci+1]?.name||`孩子${ci+2}`}`:'继续'} showChevron/></View>
    </View>);
  }

  // Holiday Schedule — 对齐Web第1449-1541行 (新增!)
  if(step==='holiday-schedule'){
    return (<View className="ob-page"><ObHeader onBack={goBack}/>
      <ScrollView scrollY enhanced class="ob-step-body">
        <Text className="ob-step-title">您的孩子有假期作息变化吗？</Text>
        <Text className="ob-step-hint">寒暑假、小长假期间日程会和平日不同</Text>
        <View className="chk-row" style={{marginTop:28}}>
          <View className={`chk-box ${profile.hasHolidaySchedule?'on':''}`} onClick={()=>setProfile(p=>({...p,hasHolidaySchedule:!p.hasHolidaySchedule}))}>
            {profile.hasHolidaySchedule&&<Icon name="check" size={22} color="#fff"/>}</View>
          <Text className="chk-lbl">假期作息与平日不同</Text></View>
        {profile.hasHolidaySchedule&&(<View style={{marginTop:20}}>
          <View className="schedule-card" style={{marginBottom:16}}>
            <View style={{display:'flex',alignItems:'center',gap:10,marginBottom:16}}><Icon name="sun" size={28} color="#f59e0b"/><Text style={{fontSize:27,fontWeight:800}}>假期大致作息</Text></View>
            <View style={{display:'flex',alignItems:'center',gap:16}}>
              <View style={{flex:1}}><Text className="mini-label">起床</Text>
                <Picker mode='time' value={profile.holidayDaySchedule.start} onChange={(e:any)=>setProfile(p=>({...p,holidayDaySchedule:{...p.holidayDaySchedule,start:e.detail.value}}))}>
                  <View className="time-pick-box"><Text>{profile.holidayDaySchedule.start}</Text></View></Picker></View>
              <Icon name="chevronRight" size={24} color="#ccc"/>
              <View style={{flex:1}}><Text className="mini-label">就寝</Text>
                <Picker mode='time' value={profile.holidayDaySchedule.end} onChange={(e:any)=>setProfile(p=>({...p,holidayDaySchedule:{...p.holidayDaySchedule,end:e.detail.value}}))}>
                  <View className="time-pick-box"><Text>{profile.holidayDaySchedule.end}</Text></View></Picker></View>
            </View>
          </View>
          <View className="schedule-card">
            <View style={{display:'flex',alignItems:'center',gap:10,marginBottom:14}}><Icon name="calendarRange" size={28} color="#006e1c"/><Text style={{fontSize:27,fontWeight:800}}>假期特别活动</Text></View>
            <View style={{display:'flex',flexWrap:'wrap',gap:12}}>{HOLIDAY_ACTS.map(act=>{
              const sel=profile.holidayCustomActivities.includes(act);return(
                <View key={act} className={`hol-tag ${sel?'active':''}`} onClick(()=>{
                  const nl=sel?profile.holidayCustomActivities.filter(a!==act):[...profile.holidayCustomActivities,act];
                  setProfile(p=>({...p,holidayCustomActivities:nl}));
                }}><Text style={{fontSize:24,fontWeight:800,color:sel?'#006e1c':'#666'}}>{act}</Text></View>);
            })}</View>
          </View>
        </View>)}
        <View className="sp-h"/>
      </ScrollView>
      <ObFooter onNext={goNext} btnText="下一步"/>
    </View>);
  }

  // Priorities — 对齐Web第1543-1580行 (emoji卡片!)
  if(step==='priorities'){
    return (<View className="ob-page"><ObHeader onBack={goBack}/>
      <ScrollView scrollY enhanced class="ob-step-body">
        <Text className="ob-step-title">您最看重哪些方面？</Text>
        <Text className="ob-step-hint">选择 2-3 个优先级，AI 将据此推荐任务</Text>
        <View style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:16,marginTop:24}}>
          {PRIORITY_OPTS.map(pri=>{
            const sel=profile.priorities.includes(pri.id);return(
              <View key={pri.id} className={`pri-card ${sel?'active':''}`}
                onClick={()=>{const nl=sel?profile.priorities.filter(p!==pri.id):[...profile.priorities,pri.id];setProfile(p=>({...p,priorities:nl}));}}>
                <Text style={{fontSize:52,display:'block',textAlign:'center',marginBottom:8}}>{pri.emoji}</Text>
                <Text style={{fontSize:26,fontWeight:700,textAlign:'center',color:sel?'#006e1c':'#333'}}>{pri.label}</Text></View>);
          })}
        </View>
        <View className="sp-h"/>
      </ScrollView>
      <ObFooter onNext={doAnalyze} btnText="开始智能分析"/>
    </View>);
  }

  // Analyzing — 对齐Web第1582-1703行
  if(step==='analyzing'){
    const steps=[
      {key:'age',l:'年龄与阶段分析',d:profile.children.map(c=>`${c.age}岁·${c.grade}`).join('、')},
      {key:'school',l:'作息时间分析',d:`上学 ${profile.children[0]?.schoolTime.start}-${profile.children[0]?.schoolTime.end}`},
      {key:'acts',l:'课外活动分析',d:profile.children.some(c=>c.afterSchoolActivities.length>0)?profile.children.flatMap(c=>c.afterSchoolActivities).join('、'):'暂无'},
      {key:'pri',l:'家长关注重点',d:profile.priorities.map(p=>({study:'📚学习',health:'💪健康',housework:'🧹家务',social:'🤝社交',hobby:'🎨兴趣',responsibility:'⭐责任'}[p]).join('、')},
      {key:'ai',l:'AI 智能推荐',d:aiStatus==='done'?'AI 推荐已完成 ✓':`等待中 (${aiSec}s)...`},
    ];
    return (<View className="ob-page ob-center">
      <View className="analyze-spin"><Icon name="sparkles" size={68} color={aiStatus==='done'?'#22c55e':'#006e1c'}/></View>
      <Text style={{fontSize:36,fontWeight:900,color:'#333',marginTop:28,textAlign:'center',display:'block'}}>{aiStatus==='done'?'AI 分析完成！':'AI 正在分析...'}</Text>
      <Text style={{fontSize:26,color:'#666',textAlign:'center',marginTop:6,display:'block'}}>{aiStatus==='done'?'已为您生成个性化任务建议':'正在调用 AI 模型分析家庭画像'}</Text>
      {aiStatus==='waiting'&&(<View style={{width:'100%',maxWidth:480,marginTop:28}}>
        <View style={{display:'flex',justifyContent:'space-between',fontSize:22,marginBottom:8}}>
          <Text style={{color:'#666',fontWeight:700}}>已等待 <Text style={{color:'#006e1c',fontWeight:900}}>{aiSec}</Text> 秒</Text>
          <Text style={{color:aiSec>10?'#f59e0b':'rgba(0,0,0,0.3)',fontWeight:900}}>{aiSec<=5?'连接中...':aiSec<=10?'AI 思考中...':'响应较慢...'}</Text></View>
        <View className="prog-track"><View className="prog-fill" style={{width:`${Math.min((aiSec/15)*100,100)}%`}}/></View>
      </View>)}
      <View className="schedule-card" style={{marginTop:32,width:'100%',maxWidth:520}}>
        <View style={{display:'flex',alignItems:'center',gap:10,marginBottom:16}}><Icon name="lightbulb" size={26} color="#006e1c"/><Text style={{fontSize:26,fontWeight:900}}>分析维度</Text></View>
        {steps.map((s,i)=><View key={i} style={{display:'flex',alignItems:'flex-start',gap:12,marginBottom:14}}>
          <Icon name={s.key==='ai'?(aiStatus==='done'?'checkCircle2':'loader2'):'checkCircle2'} size={24}
            color={s.key==='ai'?(aiStatus==='done'?'#22c55e':'#006e1c'):'#006e1c'}/><View>
          <Text style={{fontSize:25,fontWeight:800,color:'#333'}}>{s.l}</Text><Text style={{fontSize:21,color:'#666'}}>{s.d}</Text></View></View>)}
      </View>
    </View>);
  }

  // Recommendations — 对齐Web第1705-1873行
  if(step==='recommendations'){
    const sc=selRecs.size;
    const tI=recs.filter(t=>t.type!=='habit'), hI=recs.filter(t=>t.type==='habit');
    return (<View className="ob-page"><ObHeader onBack={()=>setStep('priorities')} right={<Text className="step-rec-header">已选 {sc}/{recs.length}</Text>}/>
      <View style={{textAlign:'center',padding:'4rpx 24rpx'}}><Text className="ob-step-title" style={{fontSize:32}}>选择您需要的项目（可多选）</Text></View>
      <ScrollView scrollY enhanced class="ob-step-body rec-body">
        {/* 任务列表 */}
        {tI.length>0&&(<View style={{marginBottom:28}}>
          <View style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:14}}>
            <View style={{display:'flex',alignItems:'center',gap:8}}><Icon name="target" size={24} color="#006e1c"/><Text style={{fontSize:23,fontWeight:900,textTransform:'uppercase',color:'#666'}}>每日任务</Text></View>
            <Text style={{fontSize:21,fontWeight:800,background:'#eff6ff',color:'#2563eb',padding:'4rpx 14rpx',borderRadius:'99rpx'}}>{tI.filter(t=>selRecs.has(t.id)).length}/{tI.length}</Text></View>
          <View style={{display:'flex',flexDirection:'column',gap:10,maxHeight:440,overflowY:'auto'}}>
            {tI.map(task=>{const sl=selRecs.has(task.id);return(
              <View key={task.id} className={`rec-card ${sl?'sel':''}`} onClick={()=>toggle(task.id)}>
                <View className={`rec-icon ${sl?'sel':''}`}><Icon name={task.icon==='Sparkles'?'sparkles':task.icon.toLowerCase()} size={32} color={sl?'#16a34a':'#999'}/></View>
                <View style={{flex:1,minWidth:0}}>
                  <View style={{display:'flex',alignItems:'center',gap:6,flexWrap:'wrap'}}>
                    <Text style={{fontSize:26,fontWeight:900,color:sl?'#333':'#999'}}>{task.title}</Text>
                    <Text style={{fontSize:19,fontWeight:900,color:'#d97706'}}>+{task.rewardStars}⭐</Text></View>
                  <Text style={{fontSize:21,color:sl?'#666':'#bbb',marginTop:2,display:'block',overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}>{task.description}</Text>
                  {task.suggestedTime&&<View style={{display:'inline-flex',alignItems:'center',gap:4,marginTop:6,padding:'4rpx 12rpx',borderRadius:'99rpx',background:'rgba(0,110,28,0.06)'}}>
                    <Icon name="clock" size={16} color="#006e1c"/><Text style={{fontSize:18,fontWeight:800,color:'#006e1c'}}>{task.suggestedTime}</Text></View>}
                </View>
                <View className={`rec-chk ${sl?'sel':''}`}>{sl&&<Icon name="checkCircle2" size={22} color="#fff"/>}</View>
              </View>);})}
          </View></View>)}

        {/* 习惯列表 */}
        {hI.length>0&&(<View>
          <View style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:14}}>
            <View style={{display:'flex',alignItems:'center',gap:8}}><Icon name="sparkles" size={24} color="#a855f7"/><Text style={{fontSize:23,fontWeight:900,textTransform:'uppercase',color:'#666'}}>养成习惯</Text></View>
            <Text style={{fontSize:21,fontWeight:800,background:'#faf5ff',color:'#9333ea',padding:'4rpx 14rpx',borderRadius:'99rpx'}}>{hI.filter(t=>selRecs.has(t.id)).length}/{hI.length}</Text></View>
          <View style={{display:'flex',flexDirection:'column',gap:10,maxHeight:360,overflowY:'auto'}}>
            {hI.map(hab=>{const sl=selRecs.has(hab.id);return(
              <View key={hab.id} className={`rec-card habit ${sl?'sel':''}`} onClick={()=>toggle(hab.id)}>
                <View className={`rec-icon habit ${sl?'sel':''}`}><Icon name="sparkles" size={32} color={sl?'#9333ea':'#999'}/></View>
                <View style={{flex:1,minWidth:0}}>
                  <View style={{display:'flex',alignItems:'center',gap:6,flexWrap:'wrap'}}>
                    <Text style={{fontSize:26,fontWeight:900,color:sl?'#333':'#999'}}>{hab.title}</Text>
                    <Text style={{fontSize:19,fontWeight:900,color:'#9333ea'}}>+{hab.rewardStars}⭐·21天</Text></View>
                  <Text style={{fontSize:21,color:sl?'#666':'#bbb',marginTop:2,display:'block',overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}>{hab.description}</Text>
                </View>
                <View className={`rec-chk habit ${sl?'sel':''}`}>{sl&&<Icon name="checkCircle2" size={22} color="#fff"/>}</View>
              </View>);})}
          </View></View>)}
        <View className="sp-h-lg"/>
      </ScrollView>
      <ObFooter onNext={goNext} disabled={!canGo()} btnText={sc===0?'请先选择任务':`AI推荐设置 (${sc}个任务)`} showCheck/>
    </View>);
  }

  // Preview — 对齐Web第1875-2135行
  if(step==='preview'){
    const sel=recs.filter(t=>selRecs.has(t.id)), tI=sel.filter(t=>t.type!=='habit'), hI=sel.filter(t=>t.type==='habit');
    const allActs=profile.children.flatMap(c=>[...c.afterSchoolActivities,...c.customActivities]);
    const famName=profile.children.map(c=>c.name).join('、');
    return (<View className="ob-page"><ObHeader onBack={()=>setStep('recommendations')} right={<Text className="step-num">预览</Text>}/>
      <ScrollView scrollY enhanced class="ob-step-body">

        {/* 家庭渐变卡 — 对齐Web第1889-1906行 */}
        <View className="fam-gradient-card"><Text style={{fontSize:36,fontWeight:900,color:'#fff'}}>{famName||'我的家'}</Text>
          <View style={{display:'flex',flexWrap:'wrap',gap:12,marginTop:20}}>
            {profile.children.map((c,i)=><View key={i} className="fam-member-tag">
              <Text style={{fontSize:36}}>{c.avatar||(c.gender==='boy'?'👦':'👧')}</Text>
              <View><Text style={{fontSize:24,fontWeight:900,color:'#fff'}}>{c.name||`孩子${i+1}`}</Text>
              <Text style={{fontSize:18,color:'rgba(255,255,255,0.7)'}}>{c.age}岁·{c.grade}</Text></View></View>)}
          </View></View>

        {/* 作息概览 — 对齐Web第1909-1950行 */}
        <View className="schedule-card" style={{marginBottom:20}}>
          <View style={{display:'flex',alignItems:'center',gap:10,marginBottom:16}}><Icon name="clock" size={24} color="#006e1c"/><Text style={{fontSize:26,fontWeight:900}}>作息概览</Text></View>
          {profile.children.map((c,idx)=><View key={idx} className={idx>0?'pv-divider':''}>
            <Text style={{fontSize:23,fontWeight:700,color:'#666',marginBottom:10,display:'block'}}>{c.name||`孩子${idx+1}`}</Text>
            <View style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:12}}>
              <View className="overview-cell ov-warn"><Text className="ov-label">上学时间</Text><Text className="ov-val">{c.schoolTime.start}-{c.schoolTime.end}</Text></View>
              <View className="overview-cell ov-blue"><Text className="ov-label">就寝时间</Text><Text className="ov-val">21:00</Text></View>
            </View></View>)}
          {allActs.length>0&&<View style={{marginTop:16,paddingTop:16,borderTop:'2rpx solid rgba(0,0,0,0.05)'}}>
            <Text style={{fontSize:19,color:'rgba(0,0,0,0.3)',marginBottom:8,display:'block'}}>课外活动</Text>
            <View style={{display:'flex',flexWrap:'wrap',gap:8}}>{allActs.map((a,i)=><View key={i} className="act-tag"><Text>{a}</Text></View>)}</View>
          </View>}
          {profile.priorities.length>0&&<View style={{marginTop:12,display:'flex',flexWrap:'wrap',gap:8}}>
            <Text style={{fontSize:19,color:'rgba(0,0,0,0.35)',marginRight:6}}>关注重点：</Text>
            {profile.priorities.map(p=><View key={p} className="pri-mini-tag">{{study:'📚学习',health:'💪健康',housework:'🧹家务',social:'🤝社交',hobby:'🎨兴趣',responsibility:'⭐责任'}[p]}</View>)}
          </View>}
        </View>

        {/* 任务列表 */}
        {tI.length>0&&<View className="schedule-card" style={{marginBottom:20}}>
          <View style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:14}}>
            <View style={{display:'flex',alignItems:'center',gap:8}}><Icon name="target" size={24} color="#006e1c"/><Text style={{fontSize:26,fontWeight:900}}>📋 每日任务</Text></View>
            <Text className="count-badge blue">{tI.length} 个任务</Text></View>
          <View style={{display:'flex',flexDirection:'column',gap:8,maxHeight:280,overflowY:'auto'}}>
            {tI.map((t,i)=><View key={t.id} className="prev-task-item">
              <Text className="prev-idx">#{i+1}</Text>
              <View style={{flex:1,minWidth:0}}>
                <View style={{display:'flex',alignItems:'center',gap:6}}><Text style={{fontSize:24,fontWeight:900,color:'#333'}}>{t.title}</Text>
                <Text style={{fontSize:20,color:'#d97706',fontWeight:800}}>+{t.rewardStars}⭐</Text></View>
                {t.suggestedTime&&<Text style={{fontSize:19,color:'#006e1c',fontWeight:800,display:'block',marginTop:2}}>{t.suggestedTime}</Text>}</View>
              <Text className="type-badge">{t.type==='weekly'?'每周':'每日'}</Text>
            </View>)}
          </View></View>}

        {/* 习惯列表 */}
        {hI.length>0&&<View className="schedule-card" style={{marginBottom:20}}>
          <View style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:14}}>
            <View style={{display:'flex',alignItems:'center',gap:8}}><Icon name="sparkles" size={24} color="#a855f7"/><Text style={{fontSize:26,fontWeight:900}}>✨ 养成习惯</Text></View>
            <Text className="count-badge purple">{hI.length} 个习惯</Text></View>
          <View style={{display:'flex',flexDirection:'column',gap:8,maxHeight:240,overflowY:'auto'}}>
            {hI.map((h,i)=><View key={h.id} className="prev-habit-item">
              <Text className="prev-idx purple">#{i+1}</Text>
              <View style={{flex:1,minWidth:0}}>
                <View style={{display:'flex',alignItems:'center',gap:6}}><Text style={{fontSize:24,fontWeight:900,color:'#333'}}>{h.title}</Text>
                <Text style={{fontSize:20,color:'#d97706',fontWeight:800}}>+{h.rewardStars}⭐</Text></View>
                <Text style={{fontSize:19,color:'#888',marginTop:2,display:'block',overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}>{h.description}</Text></View>
              <Text className="type-badge purple">21天</Text>
            </View>)}
          </View></View>}

        {/* 心愿推荐 — 对齐Web第2017-2081行 */}
        <View className="schedule-card" style={{marginBottom:20}}>
          <View style={{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:14}}>
            <Text style={{fontSize:26,fontWeight:900}}>💫 心愿推荐</Text><Text className="count-badge orange">根据孩子兴趣生成</Text></View>
          <View style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:12}}>
            {(()=>{
              const w:Array<{name:string,cost:number,icon:string,desc:string}>=[];
              profile.children.forEach(c=>{
                const as=[...c.afterSchoolActivities,...c.customActivities];
                if(c.age<=6)w.push({name:`${c.name}想要的玩具`,cost:20,icon:'🧸'}, {name:'去游乐场玩一天',cost:30,icon:'🎡'}, {name:'选一本新绘本',cost:15,icon:'📖'}, {name:'多看30分钟动画',cost:10,icon:'📺'});
                else if(c.age<=12)w.push({name:`${c.name}的新文具套装`,cost:25,icon:'✏️'}, {name:'选择周末去哪玩',cost:35,icon:'🎢'}, {name:'买一套乐高积木',cost:50,icon:'🧱'}, {name:'游戏时间+1小时',cost:20,icon:'🎮'});
                else w.push({name:`${c.name}想要的新装备`,cost:60,icon:'🎧'}, {name:'和朋友出去聚会',cost:40,icon:'🍕'}, {name:'购买喜欢的书籍',cost:25,icon:'📚'}, {name:'增加零花钱',cost:30,icon:'💰'});
                if(as.some(a=>['绘画','书法'].includes(a)))w.push({name:'新的画具套装',cost:35,icon:'🎨'});
                if(as.some(a=>['游泳','足球','篮球'].includes(a)))w.push({name:'运动装备一件',cost:30,icon:'⚽'});
              });
              const seen=new Set();return w.filter(x=>{if(seen.has(x.name))return false;seen.add(x.name);return true}).slice(0,6);
            })().map((wi,i)=><View key={i} className="wish-item">
              <Text style={{fontSize:32}}>{wi.icon}</Text><View style={{flex:1,minWidth:0}}>
                <Text style={{fontSize:22,fontWeight:900,color:'#333',display:'block',overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}>{wi.name}</Text>
                <Text style={{fontSize:18,color:'#888'}}>{wi.desc}</Text></View>
              <Text className="wish-cost">{wi.cost}⭐</Text>
            </View>)}
          </View>
        </View>

        {/* 特殊需求 — 对齐Web第2084-2098行 */}
        <View className="schedule-card" style={{marginBottom:20}}>
          <View style={{display:'flex',alignItems:'center',gap:10,marginBottom:12}}><Icon name="lightbulb" size={24} color="#006e1c"/><Text style={{fontSize:26,fontWeight:900}}>还有其他需求？</Text></View>
          <Text style={{fontSize:19,color:'rgba(0,0,0,0.35)',marginBottom:10,display:'block'}}>补充您的特殊需求，AI将据此优化推荐</Text>
          <Textarea className="field-input" value={profile.specialRequests} placeholder="例如：对花粉过敏、希望加强数学..."
            onInput={(e:any)=>setProfile(p=>({...p,specialRequests:e.detail.value}))} style={{minHeight:120}}/>
        </View>

        <View className="sp-h-lg"/>
      </ScrollView>

      {/* 底部按钮 — 对齐Web第2101-2128行 */}
      <View style={{padding:'16rpx 28rpx 36rpx',display:'flex',flexDirection:'column',gap:12}}>
        <View className="ob-finish-btn" onClick={confirm}><Icon name="checkCircle2" size={32} color="#fff"/>
          <Text style={{marginLeft:8,color:'#fff',fontSize:27,fontWeight:900}}>确认导入 · {profile.childrenCount}个孩子 · {tI.length}任务 · {hI.length}习惯 · 心愿</Text></View>
        <View className="ob-secondary-btn" style={{display:'flex',alignItems:'center',justifyContent:'center',gap:8}} onClick={()=>{try{Taro.setStorageSync('wishcard_onboarding_profile',JSON.stringify({profile,recommendations:recs,selectedIds:Array.from(selRecs),savedAt:new Date().toISOString()}));}catch{}
          Taro.showToast({title:'设置已保存',icon:'success'})}}>
          <Icon name="save" size={26} color="#666"/><Text style={{color:'#666',fontWeight:800}}>保存设置</Text></View>
        <View className="ob-text-btn" style={{textAlign:'center'}} onClick={()=>setStep('recommendations')}><Text>返回调整推荐内容</Text></View>
      </View>
    </View>);
  }

  // Success — 对齐Web第2137-2178行
  if(step==='success'){
    return (<View className="ob-page ob-center">
      <View className="success-icon"><Icon name="checkCircle2 size={88}" color="#22c55e"/></View>
      <Text className="success-big-title">设置完成！🎉</Text>
      <Text className="success-big-desc">已创建 {profile.childrenCount} 个孩子账户，{selRecs.size} 个任务</Text>
      <View className="schedule-card" style={{width:'100%',maxWidth:480,marginTop:24,padding:24}}>
        <Text style={{fontSize:24,color:'#666'}}>💡 提示：您可以随时在任务页面添加更多任务或调整设置</Text></View>
      <View style={{paddingTop:32,width:'100%',maxWidth:460,display:'flex',flexDirection:'column',gap:14}}>
        <View className="ob-finish-btn" onClick={()=>Taro.switchTab({url:'/pages/home/index'})}>
          <Icon name="home" size={28} color="#fff"/><Text style={{marginLeft:6,color:'#fff',fontSize:28,fontWeight:900}}>开始使用</Text></View>
        <View className="ob-secondary-btn" style={{textAlign:'center'}} onClick={()=>Taro.switchTab({url:'/pages/tasks/index'})}>
          <Text style={{color:'#666',fontWeight:800}}>查看任务列表</Text></View>
      </View>
    </View>);
  }

  return null;
}

/* ========== 子组件 ========== */
function ObHeader({onBack,right}:{onBack:()=>void,right?:any}){
  return <View className="ob-step-header">
    <View className="back-btn" onClick={onBack}><Icon name="chevronLeft" size={34} color="#333"/></View>
    {right||<View/>}
  </View>;
}
function ObFooter({onNext,btnText,disabled,showChevron,showCheck}:{onNext:()=>void;btnText:string;disabled?:boolean;showChevron?:boolean;showCheck?:boolean;}){
  if(!btnText) return null;
  return <View className="ob-bottom-bar">
    <View className={`ob-next-btn ${disabled?'disabled':''}`} onClick={disabled?undefined:onNext} style={disabled?{opacity:.4}:{}}>
      {showCheck&&<Icon name="checkCircle2" size={30} color="#fff"/>}
      <Text>{btnText}</Text>
      {showChevron&&<Icon name="chevronRight" size={30} color="#fff"/>}
    </View>
  </View>;
}
