# 微信小程序自动发布
# 复制为 miniprogram/.env，密钥只放本机，不提交仓库。
WX_APPID=wxd7b02a2e1b4451bf
WX_APP_SECRET=
WX_RELEASE_VERSION=1.0.6
WX_RELEASE_DESC=小程序分包瘦身、UI同步、AI复盘与日程链路更新

# 审核页面和类目
WX_AUDIT_ADDRESS=pages/login/index
WX_AUDIT_TITLE=WishCard 家庭管家
WX_AUDIT_TAG=家庭,日程,习惯,教育
WX_AUDIT_FIRST_CLASS=
WX_AUDIT_SECOND_CLASS=
WX_AUDIT_THIRD_CLASS=
WX_AUDIT_FIRST_ID=
WX_AUDIT_SECOND_ID=
WX_AUDIT_THIRD_ID=

# 高级用法：直接填微信 submit_audit 的 item_list JSON，可覆盖上面的类目字段。
WX_AUDIT_ITEM_LIST=

# 自动等待审核通过并发布时使用。
WX_AUDIT_POLL_INTERVAL_MS=60000
WX_AUDIT_TIMEOUT_MS=7200000

# 如微信开发者工具安装位置不同，可覆盖 CLI 路径。
WECHAT_DEVTOOLS_CLI=/Applications/wechatwebdevtools.app/Contents/MacOS/cli
